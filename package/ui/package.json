{
  "name": "@flairstech-aimy/ui",
  "version": "0.13.0",
  "description": "AiMY UI as an npm package: import components plus two stylesheets, no Tailwind needed. Internal to FlairsTech; served from the AiMY UI registry.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tailwindcss -i src/styles.css -o dist/styles.css --minify"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "lucide-react": "1.62.0",
    "class-variance-authority": "0.7.1",
    "radix-ui": "1.8.1",
    "@flairstech-aimy/tokens": "^0.13.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "tailwindcss": "4.3.3",
    "tsup": "9.0.0",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flairstech-AIMY/aimy-ui-lib.git",
    "directory": "package/ui"
  }
}
