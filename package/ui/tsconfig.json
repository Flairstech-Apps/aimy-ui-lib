{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@/lib/utils": [
        "../../registry/aimy/lib/utils.ts"
      ],
      "@/hooks/*": [
        "../../registry/aimy/hooks/*"
      ],
      "@/components/aimy-mark": [
        "../../registry/aimy/brand/aimy-mark.tsx"
      ],
      "@/components/*": [
        "../../registry/aimy/ui/*"
      ],
      "@/lib/theme": [
        "../../registry/aimy/lib/theme.ts"
      ],
      "@/lib/ai-types": [
        "../../registry/aimy/lib/ai-types.ts"
      ]
    }
  },
  "include": [
    "src",
    "../../registry/aimy"
  ]
}
