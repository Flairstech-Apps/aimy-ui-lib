{
  "name": "aimy-ui-lib",
  "version": "0.0.1",
  "private": true,
  "description": "AiMY UI: the React + TypeScript component library for AiMY products (internal to FlairsTech)",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "registry:build": "node -e \"require('fs').rmSync('public/r',{recursive:true,force:true})\" && shadcn build --output public/r",
    "build": "pnpm registry:build && node scripts/npm-registry.mjs build && next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:doctrine": "node scripts/doctrine-lint.mjs",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:doctrine && pnpm test",
    "deploy": "pnpm build && wrangler deploy",
    "npm:publish": "node scripts/npm-registry.mjs publish"
  },
  "dependencies": {
    "@flairstech-aimy/tokens": "link:package\\tokens",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "wrangler": "4.153.0"
  }
}
